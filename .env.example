# Port der Seite
PORT=3200
# Öffentliche Adresse (für Links in den E-Mails), ohne Schrägstrich am Ende
BASE_URL=http://localhost:3200
# Zugang zur Verwaltung unter /admin (beliebiger Benutzername, dieses Passwort). Unbedingt ändern, nur über HTTPS betreiben.
ADMIN_PASSWORD=
# Name des Veranstalters in den Mails
VERANSTALTER=Eduard
# Antwortadresse für Kunden und Empfänger der Meldungen über neue Anmeldungen
KONTAKT_EMAIL=
# PayPal.me-Name (paypal.me/<NAME>). Leer = nur "bar vor Ort" in den Mails
PAYPAL_ME=
# Link für die Nachbereitung (z. B. Bewertungsseite oder Instagram). Leer = ohne Link
FEEDBACK_URL=
# Treffpunkt und Preis, die beim Anlegen eines Termins vorgeschlagen werden
ORT_STANDARD=Talweg, direkt an der S-Bahn-Station Neuwiedenthal
PREIS_STANDARD=40
# E-Mail-Versand (SMTP). Ohne SMTP_HOST werden Mails nur im Postausgang der Verwaltung gespeichert (Testmodus).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
